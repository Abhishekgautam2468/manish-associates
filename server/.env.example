PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy (nginx, Render, etc.)
TRUST_PROXY=

# MongoDB. The local one below is started by "npm run dev" (data in server/data/mongo).
# For Atlas, replace it with your connection string, for example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/manish_associates?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27018/manish_associates

# Admin account (used only on first run, when the database has no admin yet)
ADMIN_USERNAME=manish
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Email for password reset codes. Leave SMTP_HOST empty in development to print codes in the terminal.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Manish Associates <no-reply@example.com>"
